// ═══════════════════════════════════════════════════════════
//  UTILITIES
// ═══════════════════════════════════════════════════════════

/**
 * Export any HTML table to CSV and trigger a download on the user's device.
 * Strips HTML tags from cells so progress bars / links don't corrupt the file.
 * @param {string} tableId   - id of the <table> or <tbody> element
 * @param {string} filename  - desired filename (e.g. "hosts.csv")
 */
function exportTableToCSV(tableId, filename) {
    const table = document.getElementById(tableId);
    if (!table) { alert("Table not found"); return; }

    const rows  = table.closest("table")
                       ? table.closest("table").querySelectorAll("tr")
                       : table.querySelectorAll("tr");

    const csvLines = [];
    rows.forEach(row => {
        const cells = row.querySelectorAll("th, td");
        const line  = Array.from(cells).map(cell => {
            // Strip HTML, trim, wrap in quotes if contains comma/quote/newline
            let text = cell.innerText.replace(/\n/g, " ").trim();
            if (text.includes(",") || text.includes('"') || text.includes("\n")) {
                text = '"' + text.replace(/"/g, '""') + '"';
            }
            return text;
        }).join(",");
        csvLines.push(line);
    });

    const blob = new Blob(["\uFEFF" + csvLines.join("\n")], // BOM for Excel UTF-8
                          { type: "text/csv;charset=utf-8;" });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement("a");
    a.href     = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

/**
 * Live search/filter on a tbody — hides rows that don't match.
 * @param {string} inputId  - id of the search <input>
 * @param {string} tbodyId  - id of the <tbody> to filter
 */
function liveSearch(inputId, tbodyId) {
    const input = document.getElementById(inputId);
    const tbody = document.getElementById(tbodyId);
    if (!input || !tbody) return;

    input.addEventListener("input", () => {
        const q = input.value.toLowerCase().trim();
        tbody.querySelectorAll("tr").forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(q) ? "" : "none";
        });
    });
}


// ═══════════════════════════════════════════════════════════
//  NAVIGATION
// ═══════════════════════════════════════════════════════════
function goToPage(page) {

    if (page === "create_vm") {
        let params   = new URLSearchParams();
        let selected = document.querySelectorAll(".vc-check:checked");
        if (selected.length > 0) params.set("vcenter", selected[0].value);
        let run_id = document.getElementById("runFilter")?.value;
        if (run_id) params.set("run_id", run_id);
        window.location.href = `/create_vm?${params.toString()}`;
        return;
    }

    let selected = document.querySelectorAll(".vc-check:checked");
    if (selected.length === 0) { alert("Select at least one vCenter"); return; }

    let vcenters = [];
    selected.forEach(cb => vcenters.push(cb.value));

    let run_id = document.getElementById("runFilter")?.value;
    let params = new URLSearchParams();
    params.append("vcenter", vcenters.join(","));
    if (run_id) params.append("run_id", run_id);

    window.location.href = `/${page}?${params.toString()}`;
}


// ═══════════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════════
if (window.location.pathname === "/") {
    loadDashboard();
}

function loadDashboard() {
    let run_id = document.getElementById("runFilter")?.value;
    let url    = "/api/dashboard";
    if (run_id) url += "?run_id=" + run_id;

    fetch(url)
        .then(res => res.json())
        .then(data => {
            const table     = document.getElementById("inventoryTable");
            const runSelect = document.getElementById("runFilter");
            table.innerHTML = "";

            if (runSelect) {
                runSelect.innerHTML = "";
                data.runs.forEach(run => {
                    runSelect.innerHTML +=
                        `<option value="${run.run_id}">Run ${run.run_id} - ${run.run_timestamp}</option>`;
                });
                runSelect.value    = data.run_id;
                runSelect.onchange = () => loadDashboard();
            }

            if (!data.data || data.data.length === 0) {
                table.innerHTML = "<tr><td colspan='20'>No data found</td></tr>";
                return;
            }

            function toNum(v)    { return parseFloat(v || 0); }
            function fmtTB(v)    { return (toNum(v) / 1024).toFixed(1) + " TB"; }
            function pBar(value) {
                value = toNum(value);
                const color = value > 90 ? "red" : value > 70 ? "orange" : "green";
                return `<div class="progress">
                    <div class="progress-bar" style="width:${value}%;background:${color}">
                        ${value.toFixed(1)}%
                    </div></div>`;
            }

            data.data.forEach(row => {
                table.innerHTML += `
                    <tr>
                        <td><input type="checkbox" class="vc-check" value="${row.Vcenter}"></td>
                        <td><b>${row.Vcenter}</b></td>
                        <td>${row.ip_vcenter}</td>
                        <td>${row.num_clusters}</td>
                        <td>${row.num_hosts}</td>
                        <td>${row.num_datastores}</td>
                        <td>${row.num_vms}</td>
                        <td>${row.total_cores}</td>
                        <td>${pBar(row.cpu_usage_percent)}<h1></h1><small>${row.used_cores} Cores</td>
                        <td>${row.free_cores}</td>
			<td>${fmtTB(row.total_memory_gb)} GB</td>
                        <td>${pBar(row.memory_usage_percent)}<small>Used: ${toNum(row.used_memory_gb).toFixed(1)} GB</small></td>
                        <td>${toNum(row.free_memory_gb).toFixed(1)} GB</td>
                        <td>${fmtTB(row.total_storage_gb)}</td>
                        <td>${pBar(row.storage_usage_percent)}<small>Used: ${fmtTB(row.used_storage_gb)}</small></td>
                        <td>${fmtTB(row.free_storage_gb)}</td>
                        <td>${row.Subscription_cpu_ratio}<h1></h1><small> ${row.total_cpu_vms} Cores<br></small></td>
                        <td>${row.Subscription_memory_ratio}<h1></h1><small>${row.total_memory_vms_gb} GB<br></small></td>
                        <td>${row.Subscription_storage_ratio}<h1></h1><small>${row.total_disk_size_gb} GB<br></small></td>
	           </tr>`;
            });
        })
        .catch(err => console.error("Dashboard Error:", err));
}


